# apps/mcp — environment variables
#
# Copy this file to apps/mcp/.env.local and fill in the values below:
#   cp apps/mcp/.env.example apps/mcp/.env.local
#
# .env.local is gitignored — NEVER commit real values.
# After editing, restart the MCP dev server (`pnpm --filter @ghbounty/mcp dev`)
# — Next.js does NOT hot-reload env vars.

# =================================================================
# REQUIRED — Supabase (any tool call needs these)
# =================================================================

# Supabase Project URL.
# Find at: Supabase Studio → Project Settings → API → "Project URL".
SUPABASE_URL=

# Service-role key (admin privileges). DO NOT use the anon/publishable key here.
# Find at: Supabase Studio → Project Settings → API → "Service role" → click eye to reveal.
# Rotates independently from the frontend's keys.
SUPABASE_SERVICE_ROLE_KEY=

# =================================================================
# REQUIRED — Solana
# =================================================================

# Solana RPC endpoint.
# For devnet:  https://api.devnet.solana.com  (public, rate-limited — fine for testing)
#              or a Helius/QuickNode devnet URL
# For mainnet: a paid Helius mainnet endpoint
SOLANA_RPC_URL=https://api.devnet.solana.com

# =================================================================
# REQUIRED — Chain registry
# Used by bounties.list, bounties.get, submissions.get.
# Must match a row in the chain_registry table.
# =================================================================

# Options:
#   solana-devnet    (test network — use for local / devnet smoke testing)
#   solana-mainnet   (production with real money)
CHAIN_ID=solana-devnet

# =================================================================
# OPTIONAL — Gas station (only needed when MCP submits on-chain txs)
# Current Sprint A tools are read-only and DO NOT use these. Leave
# empty for local smoke testing of whoami / bounties.* / submissions.get.
# =================================================================

# Frontend's gas-station endpoint.
# Production:  https://www.ghbounty.com/api/gas-station/sponsor
# Local dev:   http://localhost:3000/api/gas-station/sponsor
GAS_STATION_SPONSOR_URL=

# Shared secret with the frontend's gas-station endpoint. Must match the value
# of GAS_STATION_SERVICE_TOKEN in frontend/.env.local.
# To generate a fresh value: openssl rand -hex 32
GAS_STATION_SERVICE_TOKEN=

# =================================================================
# PUBLIC — Safe to ship in client bundles
# =================================================================

# Self-identifies this MCP in logs and agent welcome messages.
NEXT_PUBLIC_MCP_BASE_URL=https://mcp.ghbounty.com

# Public key of the gas-station signer wallet. Used as fee_payer in unsigned
# txs returned by prepare_* tools. Match the frontend's NEXT_PUBLIC_GAS_STATION_PUBKEY.
NEXT_PUBLIC_GAS_STATION_PUBKEY=
